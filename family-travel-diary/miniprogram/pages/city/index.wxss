 .city-hero { text-align:center; padding:38rpx 24rpx 26rpx; background:linear-gradient(150deg, #FFF, #FBECDD); }
.city-illustration { width:100rpx; height:100rpx; border-radius:50%; display:flex; align-items:center; justify-content:center; margin:0 auto 16rpx; background:#EEC8A9; color:#A65B31; font-size:56rpx; }
.city-stats { display:flex; justify-content:center; gap:90rpx; margin:32rpx 0 24rpx; }
.city-stat-num { font-size:40rpx; color:#A85D33; font-weight:750; }
.date-info { display:flex; justify-content:space-around; gap:12rpx; color:#977D66; font-size:21rpx; border-top:1rpx solid #F0DCC8; padding-top:20rpx; }
.diary-row { display:flex; gap:18rpx; align-items:center; }
.diary-thumb { width:180rpx; height:150rpx; border-radius:16rpx; flex-shrink:0; background:#F3E4D6; }
.diary-info { flex:1; min-width:0; }
.diary-date { color:#B96535; font-size:22rpx; }
.diary-text { font-size:26rpx; line-height:1.5; margin:8rpx 0; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden; }
