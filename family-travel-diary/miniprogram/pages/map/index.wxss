 .map-page { padding-top:28rpx; }
.eyebrow { color:#BC764B; font-size:19rpx; letter-spacing:3rpx; margin-bottom:8rpx; }
.stats-strip { display:flex; background:#F7E9D7; border-radius:22rpx; padding:22rpx 6rpx; margin:24rpx 0; }
.stat { flex:1; text-align:center; border-right:1rpx solid #E9D3BC; }
.stat:last-child { border-right:0; }
.stat-num { font-size:38rpx; font-weight:750; color:#A95E35; }
.stat-label { font-size:22rpx; color:#92745C; margin-top:4rpx; }
.map-shell { padding:16rpx; }
.map-legend { display:flex; gap:26rpx; padding:8rpx 10rpx 18rpx; font-size:22rpx; color:#847260; }
.legend-item { display:flex; align-items:center; gap:9rpx; }
.legend-dot { width:18rpx; height:18rpx; border-radius:50%; }
.active-dot { background:#D56E38; box-shadow:0 0 0 5rpx #F8E1D0; }
.inactive-dot { background:#BFC0BD; }
.family-map { width:100%; height:520rpx; border-radius:16rpx; overflow:hidden; }
.map-caption { font-size:21rpx; padding:12rpx 6rpx 2rpx; }
.city-search-row { display:flex; align-items:center; gap:14rpx; width:100%; }
.city-search { flex:1; min-width:0; margin:0; }
.city-search-button { flex-shrink:0; height:88rpx; line-height:88rpx; margin:0; padding:0 30rpx; font-size:26rpx; white-space:nowrap; }
.search-help { color:#9A8979; font-size:22rpx; line-height:1.55; margin:12rpx 2rpx 18rpx; }
.search-summary { font-size:23rpx; color:#9A8979; margin:0 0 14rpx 2rpx; }
.city-empty { color:#9A8979; font-size:24rpx; line-height:1.6; }
.city-grid { display:grid; grid-template-columns:repeat(3, minmax(0, 1fr)); gap:12rpx; }
.city-item { background:#FFFFFF; border:1rpx solid #EEE3D7; border-radius:16rpx; padding:16rpx 12rpx; min-height:112rpx; box-sizing:border-box; }
.city-visited { background:#FFF0E2; border-color:#E8B18B; }
.city-status { color:#BFC0BD; font-size:20rpx; }
.city-visited .city-status { color:#D56E38; }
.city-name { font-size:25rpx; font-weight:650; margin:4rpx 0; }
.city-sub { font-size:19rpx; color:#9E8C7A; }
