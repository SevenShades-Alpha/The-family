 .timeline-page { padding-top: 32rpx; }
.topline { display:flex; align-items:flex-start; justify-content:space-between; margin: 6rpx 0 24rpx; }
.eyebrow { color:#BC764B; font-size:19rpx; letter-spacing:3rpx; margin-bottom:10rpx; }
.write-btn { margin: 10rpx 0 0 12rpx; white-space:nowrap; border-radius:999rpx; color:#FFF; background:#B96535; font-size:24rpx; padding:0 22rpx; line-height:74rpx; }
.filter-card { padding:18rpx 22rpx; }
.search-input { margin:0; padding:0 18rpx; height:82rpx; line-height:82rpx; font-size:26rpx; }
.filter-row { display:flex; gap:14rpx; margin-top:16rpx; }
.filter-chip { background:#F7EBDD; color:#8F6448; border-radius:999rpx; padding:12rpx 18rpx; font-size:22rpx; }
.memory-card { padding:0 0 22rpx; overflow:hidden; }
.author-row { display:flex; align-items:center; padding:22rpx 24rpx; }
.author-info { margin-left:15rpx; flex:1; }
.author-name { font-size:26rpx; font-weight:650; }
.date-badge { color:#B96535; background:#FAEBDD; border-radius:12rpx; padding:8rpx 14rpx; font-size:22rpx; }
.cover { width:100%; height:360rpx; display:block; background:#F4E9DC; }
.cover-empty { display:flex; align-items:center; justify-content:center; color:#BC825E; font-size:26rpx; }
.place-line { font-size:28rpx; font-weight:700; padding:22rpx 24rpx 8rpx; }
.pin { color:#B96535; font-size:34rpx; margin-right:8rpx; }
.diary-content { padding:0 24rpx; line-height:1.65; color:#6F5B49; font-size:26rpx; display:-webkit-box; -webkit-box-orient:vertical; -webkit-line-clamp:3; overflow:hidden; }
.tags { padding:16rpx 24rpx 0; }
.card-bottom { padding:16rpx 24rpx 0; display:flex; justify-content:space-between; }
.loading { text-align:center; padding:90rpx 0; }
.empty { text-align:center; padding:66rpx 26rpx; }
.empty-icon { font-size:56rpx; }
.empty-btn { margin-top:30rpx; }
