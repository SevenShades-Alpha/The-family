page { height:100%; background:#FFF8EE; }
.splash { position:relative; width:100%; height:100vh; min-height:100vh; overflow:hidden; background:linear-gradient(180deg,#FFF8EE 0%,#F8E9D4 100%); display:flex; align-items:center; justify-content:center; opacity:1; transition:opacity .35s ease; }
.splash-leaving { opacity:0; }
.sun { position:absolute; width:260rpx; height:260rpx; border-radius:50%; background:#E9C995; opacity:.65; top:15%; right:12%; animation:sun-in .9s ease-out both; }
.landscape { position:absolute; left:-10%; width:120%; height:32%; border-radius:50% 50% 0 0; }
.landscape-back { bottom:13%; background:#D9C29A; transform:rotate(-7deg); animation:hills-in 1s ease-out both; }
.landscape-front { bottom:-4%; height:34%; background:#A8AD83; transform:rotate(5deg); animation:hills-in 1.1s ease-out both; }
.route { position:absolute; width:320rpx; height:150rpx; border:5rpx dashed #B96535; border-left-color:transparent; border-bottom-color:transparent; border-radius:50%; top:35%; left:15%; transform:rotate(18deg); animation:route-in 1.2s ease-out both; }
.pin { position:absolute; color:#B96535; font-size:40rpx; animation:pin-in .6s ease-out both; }
.pin-one { top:32%; left:23%; }
.pin-two { top:43%; right:24%; animation-delay:.25s; }
.content { position:relative; z-index:2; width:84%; text-align:center; margin-top:8%; animation:content-in .8s ease-out both; }
.mark { margin:0 auto 24rpx; width:100rpx; height:100rpx; line-height:94rpx; border-radius:32rpx; color:#FFF8EE; background:#B96535; font-size:62rpx; box-shadow:0 14rpx 30rpx rgba(120,75,42,.18); }
.title { color:#4B392B; font-size:48rpx; font-weight:700; letter-spacing:3rpx; }
.subtitle { margin-top:22rpx; color:#806D5B; font-size:25rpx; line-height:1.7; }
.dots { display:flex; justify-content:center; gap:10rpx; margin-top:42rpx; }
.dots view { width:10rpx; height:10rpx; border-radius:50%; background:#B96535; opacity:.45; animation:dot-pulse .8s ease-in-out infinite alternate; }
.dots view:nth-child(2) { animation-delay:.2s; }.dots view:nth-child(3) { animation-delay:.4s; }
@keyframes content-in { from { opacity:0; transform:translateY(24rpx); } to { opacity:1; transform:translateY(0); } }
@keyframes sun-in { from { opacity:0; transform:scale(.7); } to { opacity:.65; transform:scale(1); } }
@keyframes hills-in { from { opacity:0; transform:translateY(50rpx) rotate(-7deg); } to { opacity:1; } }
@keyframes route-in { from { opacity:0; transform:translateX(-25rpx) rotate(18deg); } to { opacity:1; transform:translateX(0) rotate(18deg); } }
@keyframes pin-in { from { opacity:0; transform:scale(.5); } to { opacity:1; transform:scale(1); } }
@keyframes dot-pulse { from { opacity:.25; transform:scale(.8); } to { opacity:1; transform:scale(1.15); } }
