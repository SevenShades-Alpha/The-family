 .publish-page { padding-top:30rpx; padding-bottom:40rpx; }
.photo-grid { display:grid; grid-template-columns:repeat(3, 1fr); gap:14rpx; }
.photo-cell,.add-photo { height:190rpx; border-radius:16rpx; overflow:hidden; position:relative; background:#F7EBDD; }
.photo-cell image { width:100%; height:100%; }
.add-photo { display:flex; flex-direction:column; align-items:center; justify-content:center; color:#B96535; font-size:22rpx; }
.add-photo text { font-size:52rpx; line-height:1.2; }
.remove-photo { position:absolute; right:8rpx; top:8rpx; background:rgba(60,42,28,.72); color:white; border-radius:50%; width:38rpx; height:38rpx; text-align:center; line-height:34rpx; font-size:30rpx; }
.story-input { height:240rpx; min-height:240rpx; padding:20rpx 22rpx; line-height:1.65; box-sizing:border-box; }
.field-label { font-size:24rpx; color:#8D7967; margin-top:10rpx; }
.two-col { display:flex; flex-direction:column; gap:0; }
.field-half { flex:1 1 auto; width:100%; min-width:0; }
.location-actions { gap:14rpx; margin:4rpx 0 14rpx; }
.compact-btn { margin:0; font-size:22rpx; line-height:66rpx; height:66rpx; padding:0 20rpx; white-space:nowrap; }
.search-row { gap:12rpx; align-items:center; }
.search-place { flex:1; min-width:0; margin:0; }
.suggestion-list { background:#FFFCF7; border:1rpx solid #EFE1D1; border-radius:14rpx; overflow:hidden; }
.suggestion { padding:18rpx; border-bottom:1rpx solid #F0E5D9; }
.suggestion:last-child { border-bottom:0; }
.suggestion-title { font-weight:600; margin-bottom:5rpx; }
.coordinate { margin-top:12rpx; }
.picker-input { color:#6D5949; }
.publish-btn { margin-top:12rpx; }
.bottom-note { text-align:center; font-size:22rpx; color:#A59484; margin:20rpx 0; }
