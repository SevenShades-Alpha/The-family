 .author-card { display:flex; align-items:center; }
.author-copy { margin-left:18rpx; }
.author-name { font-size:28rpx; font-weight:700; }
.photo-swiper { height:520rpx; border-radius:22rpx; overflow:hidden; margin-bottom:22rpx; }
.detail-image { width:100%; height:520rpx; }
.full-content { white-space:pre-wrap; line-height:1.8; margin-top:22rpx; color:#665443; font-size:28rpx; }
.info-row { display:flex; padding:15rpx 0; border-bottom:1rpx solid #F5ECE1; line-height:1.5; }
.info-row:last-child { border-bottom:0; }
.info-label { width:150rpx; flex-shrink:0; color:#9A8979; }
.detail-map { width:100%; height:300rpx; border-radius:18rpx; overflow:hidden; }
.map-caption { margin-top:12rpx; }
.social-row { display:flex; align-items:center; gap:20rpx; margin:18rpx 4rpx; }
.like-btn { background:#F6E6D7; color:#9B5730; border-radius:999rpx; font-size:25rpx; margin:0; line-height:72rpx; padding:0 30rpx; }
.like-btn.liked { background:#F2D3C2; color:#A3472D; }
.comments-card { padding:24rpx; }
.comment-item { display:flex; gap:14rpx; padding:20rpx 0; border-bottom:1rpx solid #F4E9DD; }
.comment-body { flex:1; min-width:0; line-height:1.55; }
.comment-head { display:flex; justify-content:space-between; gap:10rpx; margin-bottom:8rpx; }
.comment-name { font-weight:650; }
.empty-comments { padding:20rpx 0; }
.comment-compose { display:flex; align-items:center; gap:12rpx; margin-top:22rpx; }
.comment-input { flex:1; min-width:0; margin:0; padding:0 16rpx; height:82rpx; line-height:82rpx; font-size:26rpx; }
.send-btn { margin:0; line-height:68rpx; font-size:24rpx; padding:0 24rpx; }

.diary-manage-row { display:flex; align-items:center; justify-content:space-between; gap:16rpx; margin:0 4rpx 18rpx; }
.manage-hint { font-size:23rpx; }
.delete-diary-btn { margin:0; padding:0 24rpx; line-height:64rpx; height:64rpx; border-radius:999rpx; background:#FBE9E5; color:#B74735; font-size:24rpx; }
.delete-diary-btn[disabled] { opacity:.65; }
